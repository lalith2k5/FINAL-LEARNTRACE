// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  attempts             Attempt[]
  mastery              Mastery[]
  assessmentSessions   AssessmentSession[]
  roadmap              RoadmapItem[]
  domains              UserDomain[]
  progress             MaterialProgress[]
  practicalSubmissions PracticalSubmission[]
  accounts             Account[]
  sessions             Session[]
}

// ---------- Domain / Skills ----------

model Domain {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  skills      Skill[]
  users       UserDomain[]
  questions   Question[]
  materials   Material[]
  practicalTasks PracticalTask[]
}

model UserDomain {
  userId    String
  domainId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([userId, domainId])
}

model Skill {
  id          String  @id @default(cuid())
  domainId    String
  slug        String
  name        String
  description String?
  difficulty  Int     @default(2)

  domain    Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  parents   Prerequisite[]  @relation("child")
  children  Prerequisite[]  @relation("parent")
  questions QuestionSkill[]
  materials MaterialSkill[]
  mastery   Mastery[]
  roadmap   RoadmapItem[]
  practicalTasks PracticalTaskSkill[]

  @@unique([domainId, slug])
}

model Prerequisite {
  parentId String
  childId  String
  weight   Float  @default(1.0)

  parent Skill @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  child  Skill @relation("child",  fields: [childId],  references: [id], onDelete: Cascade)

  @@id([parentId, childId])
}

// ---------- Questions ----------

model Question {
  id          String  @id @default(cuid())
  domainId    String
  prompt      String
  options     Json
  correctId   String
  explanation String?
  difficulty  Int     @default(2)

  domain   Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  skills   QuestionSkill[]
  attempts Attempt[]
}

model QuestionSkill {
  questionId String
  skillId    String
  weight     Float  @default(1.0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId],    references: [id], onDelete: Cascade)

  @@id([questionId, skillId])
}

// ---------- Sessions & Attempts ----------

model AssessmentSession {
  id          String   @id @default(cuid())
  userId      String
  domainId    String
  kind        String
  questionIds Json     @default("[]")
  startedAt   DateTime @default(now())
  endedAt     DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts Attempt[]
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  questionId  String
  sessionId   String
  correct     Boolean
  selectedOptionId String?
  timeTakenMs Int
  confidence  Int?
  attemptNo   Int      @default(1)
  createdAt   DateTime @default(now())

  user     User              @relation(fields: [userId],   references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session  AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ---------- Mastery ----------

model Mastery {
  userId     String
  skillId    String
  value      Float    @default(0)
  confidence Float    @default(0)
  updatedAt  DateTime @updatedAt
  history    Json     @default("[]")

  user  User  @relation(fields: [userId],  references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

// ---------- Materials ----------

model Material {
  id       String  @id @default(cuid())
  domainId String
  title    String
  type     String
  url      String?
  body     String?
  pdfUrl   String?

  domain   Domain             @relation(fields: [domainId], references: [id], onDelete: Cascade)
  skills   MaterialSkill[]
  progress MaterialProgress[]
}

model MaterialSkill {
  materialId String
  skillId    String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId],    references: [id], onDelete: Cascade)

  @@id([materialId, skillId])
}

model MaterialProgress {
  userId      String
  materialId  String
  completed   Boolean  @default(false)
  completedAt DateTime?

  user     User     @relation(fields: [userId],     references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([userId, materialId])
}

// ---------- Roadmap ----------

model RoadmapItem {
  id       String @id @default(cuid())
  userId   String
  skillId  String
  order    Int
  priority Float
  reason   String?
  status   String @default("pending")

  user  User  @relation(fields: [userId],  references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

// ---------- Practical Learning ----------

model PracticalTask {
  id           String   @id @default(cuid())
  domainId     String
  slug         String
  title        String
  description  String
  language     String   @default("python")
  difficulty   Int      @default(2)
  starterCode  String
  solutionHint String?
  testCases    Json     @default("[]")
  createdAt    DateTime @default(now())

  domain      Domain                @relation(fields: [domainId], references: [id], onDelete: Cascade)
  skills      PracticalTaskSkill[]
  submissions PracticalSubmission[]

  @@unique([domainId, slug])
}

model PracticalTaskSkill {
  taskId  String
  skillId String

  task  PracticalTask @relation(fields: [taskId],  references: [id], onDelete: Cascade)
  skill Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([taskId, skillId])
}

model PracticalSubmission {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  code      String
  passed    Int      @default(0)
  total     Int      @default(0)
  passedAll Boolean  @default(false)
  results   Json     @default("[]")
  createdAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task PracticalTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// ---------- NextAuth ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
